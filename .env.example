# Qdrant Cloud connection. Fill these values in your local .env file.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=aic2026_siglip2_so400m_v1

# Gemini routing:
# - GEMINI_TEXT_MODEL: "Tien phuong" for query parsing / NER / object extraction / query rewrite.
# - GEMINI_VISION_MODEL: "Hau phuong" for visual Q&A over images/crops.
GEMINI_API_KEY=

GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash
# Optional: comma-separated keys for Vision failover/rotation. Leave empty to use GEMINI_API_KEY.
GEMINI_API_KEYS=
# With 3 independent keys at 5 RPM each, 4 seconds is a safe global interval.
GEMINI_VISION_MIN_INTERVAL_SEC=4

# Keep SigLIP2 SO400M as the default embedding model.
TEXT_ENCODER_MODEL=google/siglip2-so400m-patch14-384
